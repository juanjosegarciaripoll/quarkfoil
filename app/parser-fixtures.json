  {
    "name": "themes colors and duplicate IDs",
    "source": "---\ntheme: unavailable\n---\n\n# First {#repeat-section .section}\n\n---\n\n## One {#repeat-slide .layout-1 theme=unavailable foreground=no}\n\n---\n\n# Second {#repeat-section .section}\n\n---\n\n## Two {#repeat-slide .layout-1}\n",
