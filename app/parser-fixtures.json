[
  {
    "name": "front matter and layouts",
    "source": "---\ntitle: Shared corpus\ntheme: scientific-dark\n---\n\n## First {.layout-1-2 columns=\"2 3\" rows=1:1 enabled}\n\n::: left\nLeft.\n:::\n\n::: top-right\nTop.\n:::\n\n::: bottom-right\nBottom.\n:::\n\n---\n\n## Free {.layout-free}\n",
    "expected": {
      "metadata": {"title": "Shared corpus", "theme": "scientific-dark"},
      "slides": [
        {"title": "First", "layout": "1-2", "cells": ["left", "top-right", "bottom-right"], "overlays": [], "trashed": false},
        {"title": "Free", "layout": "free", "cells": [], "overlays": [], "trashed": false}
      ],
      "sections": [],
      "diagnostics": []
    }
  },
  {
    "name": "sections media and objects",
    "source": "# Results {#results .section}\n\n---\n\n## Media {.layout-1-1}\n\n::: left\n![Plot](figures/plot.svg \"Plot\")\n:::\n\n::: right {type=video src=movie.mp4 autoplay=true}\n:::\n\n::: overlay {#arrow type=arrow x1=5 y1=10 x2=80 y2=90 heads=both}\n:::\n\n::: notes\nSpeaker note.\n:::\n",
    "expected": {
      "metadata": {},
      "slides": [
        {"title": "Media", "layout": "1-1", "cells": ["left", "right"], "overlays": ["arrow"], "trashed": false}
      ],
      "sections": [{"title": "Results", "id": "results", "slideCount": 1, "isTrash": false}],
      "diagnostics": []
    }
  },
  {
