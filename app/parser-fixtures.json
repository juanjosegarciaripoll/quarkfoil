  {
    "name": "structural diagnostics",
    "source": "## Broken {.layout-unknown background=red}\n\n::: overlay {#same font-size=nope}\n:::\n\n::: overlay {#same}\n:::\n\n::: mystery\n",
    "expected": {
      "metadata": {},
      "slides": [
